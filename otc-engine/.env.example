SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Seed/source provider. This is only used to anchor the OTC price.
# The OTC stream itself is synthetic and must remain labelled OTC.
# Optional: set a Twelve Data key if available.
TWELVE_DATA_API_KEY=

# Engine settings
TICK_INTERVAL_MS=2000
CANDLE_INTERVAL_MS=60000
HISTORY_CANDLES=300
OTC_VOL_MULTIPLIER=1
